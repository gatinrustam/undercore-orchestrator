  "DeviceRequest": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
      "Capability": {
        "additionalProperties": false,
        "properties": {
          "protocol": {
            "enum": [
              "amneziawg",
              "trusttunnel"
            ],
            "title": "Protocol",
            "type": "string"
          },
          "configuration_version": {
            "maximum": 65535,
            "minimum": 1,
            "title": "Configuration Version",
            "type": "integer"
          }
        },
        "required": [
          "protocol",
          "configuration_version"
        ],
        "title": "Capability",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "schema_version": {
        "const": 1,
        "title": "Schema Version",
        "type": "integer"
      },
      "capabilities": {
        "items": {
          "$ref": "#/$defs/Capability"
        },
        "maxItems": 8,
        "minItems": 1,
        "title": "Capabilities",
        "type": "array"
      },
      "device_id": {
        "pattern": "^[A-Za-z0-9_-]{1,100}$",
        "title": "Device Id",
        "type": "string"
      },
      "name": {
        "maxLength": 80,
        "minLength": 1,
        "pattern": "^[^\\x00-\\x1f\\x7f]+$",
        "title": "Name",
        "type": "string"
      },
      "expires_at": {
        "title": "Expires At",
        "type": "string"
      }
    },
    "required": [
      "schema_version",
      "capabilities",
      "device_id",
      "name",
      "expires_at"
    ],
    "title": "DeviceRequest",
    "type": "object"
  },

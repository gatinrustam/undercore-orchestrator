      },
      "expected_external_id": {
        "pattern": "^[A-Za-z0-9_-]{1,100}$",
        "title": "Expected External Id",
        "type": "string"
      },
      "allow_create": {
        "default": true,
        "title": "Allow Create",
        "type": "boolean"

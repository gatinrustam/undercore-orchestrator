        "title": "Device Id",
        "type": "string"
      }
    },
    "required": [
      "device_id"
    ],
    "title": "DeviceOperation",
    "type": "object"
  },
  "RenewRequest": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
